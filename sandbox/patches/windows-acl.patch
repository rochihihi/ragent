+fn acl_entries_equal(left: *const ACL, right: *const ACL) -> Result<bool> {
+    if left.is_null() || right.is_null() { return Ok(left == right); }
+    if unsafe { (*left).AclRevision != (*right).AclRevision || (*left).AceCount != (*right).AceCount } {
+        return Ok(false);
+    }
+    for i in 0..unsafe { (*left).AceCount } as u32 {
+        let mut a: *mut c_void = std::ptr::null_mut();
+        let mut b: *mut c_void = std::ptr::null_mut();
+        unsafe {
+            GetAce(left, i, &mut a)?;
+            GetAce(right, i, &mut b)?;
+            let size_a = (*(a as *const ACE_HEADER)).AceSize as usize;
+            let size_b = (*(b as *const ACE_HEADER)).AceSize as usize;
+            if size_a != size_b || std::slice::from_raw_parts(a as *const u8, size_a)
+                != std::slice::from_raw_parts(b as *const u8, size_b) { return Ok(false); }
+        }
+    }
+    Ok(true)
+}
