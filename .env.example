OPENAI_API_KEY=
DEEPSEEK_API_KEY=
VERIPATCH_MODEL=gpt-5.6-terra
VERIPATCH_DEEPSEEK_MODEL=deepseek-v4-flash
VERIPATCH_DEEPSEEK_BASE_URL=https://api.deepseek.com
VERIPATCH_DEEPSEEK_LOW_BALANCE=5
VERIPATCH_REASONING_EFFORT=medium
VERIPATCH_MAX_STEPS=12
VERIPATCH_MAX_MODEL_CALLS=12
VERIPATCH_MAX_INPUT_TOKENS=500000
VERIPATCH_MAX_OUTPUT_TOKENS=50000
VERIPATCH_TEST_TIMEOUT_SECONDS=120
VERIPATCH_DATABASE_PATH=./runs/veripatch.sqlite3
VERIPATCH_TEST_RUNNER=docker
VERIPATCH_DOCKER_IMAGE=veripatch-sandbox:latest
VERIPATCH_DOCKER_CPUS=1.0
VERIPATCH_DOCKER_MEMORY=512m
VERIPATCH_DOCKER_PIDS=128
